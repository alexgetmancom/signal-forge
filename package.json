{
  "name": "signal-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/src/index.js",
    "build": "tsc -p tsconfig.json && bun scripts/copy-migrations.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test ./tests",
    "check-architecture": "bun scripts/check-architecture.ts",
    "check-migrations": "bun scripts/check-migrations.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run check-migrations && bun run check-architecture && bun run build",
    "poll": "bun src/cli.ts poll",
    "status": "bun src/cli.ts status",
    "events": "bun src/cli.ts events",
    "suppressions": "bun src/cli.ts suppressions"
  },
  "dependencies": {
    "hono": "^4.12.31",
    "zod": "^4.4.3",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
