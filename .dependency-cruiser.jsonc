/* Layer boundaries, checked on the local import graph.
 *
 * This is the only place layer rules live. scripts/check-architecture.ts reads this file, resolves
 * every relative import in src/ and reports the edges a rule forbids. The dependency-cruiser
 * config shape is used on purpose: the rules stay readable to the tool if this repository ever
 * grows into needing it, and they read the same way as the ones in the sibling repository.
 *
 * .jsonc rather than the tool's usual .cjs config: the language gate wants comments, and the
 * repository ships no JavaScript. The comments are the point -- a rule whose reason is not written
 * down is a rule that gets deleted by whoever first finds it inconvenient.
 */
{
  "forbidden": [
    {
      "name": "no-circular",
      "comment": "A cycle means neither module can be read, tested or moved on its own, and the import order that happens to work today is an accident of which file the runtime loaded first.",
      "from": {},
      "to": { "circular": true }
    },
    {
      "name": "collectors-do-not-deliver",
      "comment": "A collector's whole job is to come back with a catalog or to fail loudly. If it can reach delivery it can also decide to send, and the decision to notify a subscriber would then live in the one place that has no view of snapshots, events or suppression.",
      "from": { "path": "^src/sources/" },
      "to": { "path": "^src/delivery\\.ts$" }
    },
    {
      "name": "collectors-do-not-render",
      "comment": "What a collector returns is evidence, not a card. A collector that formats is a collector whose output cannot be diffed against the previous snapshot, which is how a changed record is detected at all.",
      "from": { "path": "^src/sources/" },
      "to": { "path": "^src/events/render/" }
    },
    {
      "name": "storage-does-not-collect",
      "comment": "Storage is called inside the transaction that commits snapshots, events and delivery jobs together. An import of a collector puts a network read on that path, where it can only turn a slow upstream into a held write lock.",
      "from": { "path": "^src/storage/" },
      "to": { "path": "^src/sources/" }
    },
    {
      "name": "storage-does-not-speak-transport",
      "comment": "Same transaction, other end: persistence that can call delivery or the HTTP server can send before the commit it is part of has landed, which is how something is delivered twice or announced and then rolled back.",
      "from": { "path": "^src/storage/" },
      "to": { "path": "^src/(delivery|http)\\.ts$" }
    },
    {
      "name": "event-persistence-does-not-render",
      "comment": "store.ts writes the event; how it reads on Discord or Telegram is a later decision. Rendering here would put subscriber-facing wording into the row, where records.body is compared byte for byte and a reworded string becomes a \"changed\" event for every record carrying it.",
      "from": { "path": "^src/events/store\\.ts$" },
      "to": { "path": "^src/events/render/" }
    },
    {
      "name": "renderers-do-not-collect",
      "comment": "A renderer draws what the pipeline already decided. Reaching into a collector makes rendering depend on a live upstream, so a card's text would differ depending on whether a fetch succeeded while it was being drawn. sources/labels.ts is exempt: it is the naming vocabulary a card needs to say which source spoke, not a collector.",
      "from": { "path": "^src/events/render/" },
      "to": { "path": "^src/sources/", "pathNot": "^src/sources/labels\\.ts$" }
    },
    {
      "name": "renderers-do-not-deliver",
      "comment": "Rendering produces a payload and hands it back. A renderer that can send is a renderer that can retry, and a delivery with an uncertain outcome must stay ambiguous rather than be retried by whatever was drawing it.",
      "from": { "path": "^src/events/render/" },
      "to": { "path": "^src/delivery\\.ts$" }
    },
    {
      "name": "delivery-does-not-collect",
      "comment": "Delivery works from the jobs the transaction wrote. Collecting at send time would mean the thing being announced is read again, separately, after the evidence for announcing it was already stored.",
      "from": { "path": "^src/delivery\\.ts$" },
      "to": { "path": "^src/sources/" }
    },
    {
      "name": "event-core-does-not-import-the-web-framework",
      "comment": "The event pipeline is driven by the poller, the CLI and the HTTP server alike. A Hono import inside it would make one of those three the shape every caller has to pretend to be.",
      "from": { "path": "^src/events/" },
      "to": { "path": "^src/http\\.ts$" }
    },
    {
      "name": "only-the-server-speaks-hono",
      "comment": "Hono is how one process happens to answer HTTP. Everything else works in domain types and codes, so the day the server is replaced, or a second entry point is added, the change is one file and not a search for every module that learned a framework's Context.",
      "from": { "path": "^src/", "pathNot": "^src/http\\.ts$" },
      "to": { "dependencyTypes": ["npm"], "path": "^(hono|@hono/)" }
    },
    {
      "name": "collectors-do-not-write-events",
      "comment": "A collector returns a collection and nothing else. Diffing it against the last snapshot, deciding what changed and writing the event happen together in the pipeline's transaction; a collector that could write an event directly would make one that no snapshot explains and no suppression saw.",
      "from": { "path": "^src/sources/" },
      "to": { "path": "^src/events/(store|pipeline|record)\\.ts$" }
    },
    {
      "name": "policy-does-not-reach-the-network",
      "comment": "Whether an event is worth a card is decided from the event and the database alone. A rule that could fetch, or ask a model, would decide differently on replay than it did live, and replaying the history is how a change to these rules is judged before it ships.",
      "from": { "path": "^src/events/(worth|signals|suppression|notification|confidence)\\.ts$" },
      "to": { "path": "^src/(http-client|jev|summary|review|deepseek)\\.ts$|^src/sources/" }
    },
    {
      "name": "models-do-not-write-evidence",
      "comment": "What a language model says about an event sits beside the evidence, never in it. Jev may think a reseller listing is a release; if its module could write events or snapshots, that opinion could become the record the rules read, and a third-party listing would turn into a confirmed launch with nothing behind it.",
      "from": { "path": "^src/(jev|summary|review)\\.ts$" },
      "to": { "path": "^src/events/(store|pipeline|record)\\.ts$|^src/storage/snapshots\\.ts$" }
    },
    {
      "name": "production-does-not-import-tests",
      "comment": "Test helpers stand in for the clock, the network and the database. An import from src/ would ship one into production, where it would quietly answer for the real thing.",
      "from": { "path": "^src/" },
      "to": { "path": "^tests/" }
    }
  ]
}
